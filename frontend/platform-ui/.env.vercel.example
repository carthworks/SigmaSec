# =============================================================================
# Vercel Environment Variables for SigmaSec Platform UI
# Set these in: Vercel Dashboard → Project → Settings → Environment Variables
# =============================================================================

# --- Backend API (Required) ---

# Public FastAPI URL — used by client-side fetch() calls in the browser.
# Must be the publicly reachable URL of your FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=https://api.sigmasec.ai

# Internal FastAPI URL — used by Next.js server-side routes and API rewrites.
# On Vercel, this should be the same as NEXT_PUBLIC_API_BASE_URL unless you
# have a private VPC connection between Vercel and your backend.
INTERNAL_API_URL=https://api.sigmasec.ai

# --- Authentication (Required) ---

# The full public URL of this Vercel deployment.
# For production: your custom domain. For preview: the Vercel preview URL.
# Vercel auto-provides VERCEL_URL — but you must set NEXTAUTH_URL explicitly.
NEXTAUTH_URL=https://app.sigmasec.ai

# Random 32+ character secret for signing NextAuth.js JWTs and cookies.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_ME_with_a_32+_char_random_string

# =============================================================================
# HOW TO DEPLOY
# =============================================================================
#
# 1. Connect your GitHub repo to Vercel.
# 2. In Vercel → Project → Settings → General, set:
#      Root Directory: frontend/platform-ui
#      Framework Preset: Next.js
# 3. In Vercel → Project → Settings → Environment Variables, add all keys above.
# 4. Push to main → Vercel auto-deploys.
#
# NOTES:
# - .env.local is NOT committed and NOT used on Vercel. Only Vercel env vars apply.
# - All API calls from the browser go directly to NEXT_PUBLIC_API_BASE_URL.
# - SSE scan progress streaming uses the /api/scans/[id]/progress serverless route
#   which is granted a 60s max duration via vercel.json.
# - Backend CORS must allow the Vercel deployment URL as an allowed origin.
# =============================================================================
