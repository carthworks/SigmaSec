# =============================================================================
# Frontend Environment Variables — copy to .env.local and fill in real values
# DO NOT commit .env.local — only commit this .env.local.example file
# =============================================================================

# --- API ---
# URL of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Auth (NextAuth.js) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_ME_with_a_32+_char_random_string

# Full public URL of this Next.js app
NEXTAUTH_URL=http://localhost:3000
