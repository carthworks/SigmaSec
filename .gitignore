# ==========================================
# AI-Augmented Security Posture Intelligence Platform
# Master .gitignore
# ==========================================

# ---- Secrets & Environment Variables ----
# Local configuration files containing API keys & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.prod
.env.dev
*.env
!.env.example
!.env.prod.example
!.env.local.example

# SSH keys & Certificates
*.pem
*.key
*.pub
secrets/
certs/

# ---- Python (Backend) ----
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
.python-version
pip-log.txt
pip-delete-this-directory.txt

# Testing & Linting cache / reports
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.hypothesis/
.ruamel_cache/
.mypy_cache/
.ruff_cache/
htmlcov/

# ---- Node.js / Next.js (Frontend) ----
# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Build caches & logs
.turbo/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/
package-lock.json.bak
.eslintcache
.stylelintcache
.prettiercache
.tsbuildinfo

# ---- Docker & Local Databases ----
# Local databases & storage
*.db
*.sqlite
*.sqlite3
postgres_data/
redis_data/
minio_data/

# Docker overrides
docker-compose.override.yml

# ---- Temporary Files & Scans ----
/tmp/
scan_data/
uploads/
*.tmp
*.bak
*.swp
*.swo
*~

# ---- Security Scanners & Tools ----
# Executable/binary downloads for security scanners
backend/tools/*
!backend/tools/.gitkeep

# ---- Editor / OS Specific ----
# Windows thumbnail database / desktop config
Thumbs.db
ehthumbs.db
desktop.ini

# macOS Finder / metadata files
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# VS Code / JetBrains / Vim
.idea/
.vscode/
!.vscode/extensions.json
*.sw?
*.swo

# ---- AI Assistants / Scratch / Notes ----
.claude/
.cursor/
.copilot/
notes/scratch/
scratch/
