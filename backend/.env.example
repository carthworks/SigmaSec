# =============================================================================
# Backend Environment Variables — copy to .env and fill in real values
# DO NOT commit .env — only commit this .env.example file
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://admin:secret@postgres:5432/mydb
REDIS_URL=redis://redis:6379
JWT_SECRET=your-secret-here
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO (Object Storage) ---
MINIO_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# --- AI (Customizable Ollama Local or Anthropic Claude) ---
AI_PROVIDER=ollama
AI_MODEL=llama3
OLLAMA_API_BASE=http://host.docker.internal:11434
# Get your key at https://console.anthropic.com/ if using 'anthropic' provider
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Security ---
# Generate with: openssl rand -base64 32
SECRET_KEY=REPLACE_ME_with_a_32+_char_random_string
# Encrypts stored GitHub/Jira/Slack credentials. REQUIRED unless ENVIRONMENT is development/test —
# the API refuses to start without it. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- App ---
# development | test | production. Anything other than development/dev/local/test is treated as production.
ENVIRONMENT=development
# Development only: fake fix PRs against a throwaway local repo when no real GitHub token is connected.
# Ignored outside development.
SIGMASEC_PR_SIMULATION=0

# --- Scan authorisation (web/Nuclei and network/Nmap scans) ---
# Max web + network scans per organisation per hour.
SIGMASEC_ACTIVE_SCANS_PER_HOUR=20
# Development only: allow web/network scans of unverified (but still public) targets. Ignored outside development.
SIGMASEC_ALLOW_UNVERIFIED_TARGETS=0
# Nuclei requests per second per scan (Nuclei's own default is 150).
NUCLEI_RATE_LIMIT=50

# --- Vercel Frontend (CORS) ---
# Set this to your Vercel deployment URL so the backend accepts cross-origin requests.
# Example: https://app.sigmasec.ai or https://sigmasec-platform.vercel.app
VERCEL_FRONTEND_URL=
